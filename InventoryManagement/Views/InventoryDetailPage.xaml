<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryManagement.Views.InventoryDetailPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="{Binding Item.ItemName}" FontSize="18" />
            <Label Text="{Binding Item.ItemId, StringFormat='Item ID: {0}'}" TextColor="Gray" />
            <Label Text="Current quantity" FontAttributes="Bold" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Text="-" Command="{Binding DecreaseQuantityCommand}" WidthRequest="52" />
                <Entry Grid.Column="1" Text="{Binding QuantityText}" Keyboard="Numeric" HorizontalTextAlignment="Center" />
                <Button Grid.Column="2" Text="+" Command="{Binding IncreaseQuantityCommand}" WidthRequest="52" />
            </Grid>
            <Label Text="{Binding Item.LastUpdated, StringFormat='Last updated: {0:G}'}" TextColor="Gray" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <Button Text="Save quantity" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
